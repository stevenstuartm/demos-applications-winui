<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="demos_applications_winui.Notes.Views.NotePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:demos_applications_winui.Notes.Models"
    xmlns:vm="using:demos_applications_winui.Notes.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Save" Label="Save"
                          Command="{x:Bind ViewModel.SaveCommand}"
                          IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"/>
            <AppBarButton Icon="Delete" Label="Delete"
                          Command="{x:Bind ViewModel.DeleteCommand}"/>
            <AppBarButton Icon="Undo" Label="Discard"
                          Command="{x:Bind ViewModel.DiscardChangesCommand}"
                          IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Attach" Label="Attach files"
                          Command="{x:Bind ViewModel.AttachFilesCommand}"
                          IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"/>
            <AppBarButton Label="Take photo"
                          Command="{x:Bind ViewModel.CapturePhotoCommand}"
                          IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE722;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarToggleButton Icon="Edit" Label="Edit mode"
                                IsChecked="{x:Bind ViewModel.IsEditMode, Mode=TwoWay}"
                                Command="{x:Bind ViewModel.ToggleModeCommand}"/>
            <CommandBar.Content>
                <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Margin="16,8"
                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
            </CommandBar.Content>
        </CommandBar>

        <!-- Title field with inline validation error -->
        <StackPanel Grid.Row="1" Spacing="2" Margin="16,8">
            <TextBox Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Note title"
                     Header="{x:Bind ViewModel.CreatedDate.ToString()}"
                     IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.TitleErrorMessage, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Visibility="{x:Bind ViewModel.ShowTitleError, Mode=OneWay}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <WebView2 x:Name="EditorWebView"
                       Visibility="{x:Bind ViewModel.IsEditorReady, Mode=OneWay}"/>
            <ProgressRing IsActive="{x:Bind ViewModel.IsEditorLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsEditorLoading, Mode=OneWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
        </Grid>

        <!-- Attachment Gallery -->
        <Border Grid.Row="3" Padding="16,8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                Visibility="{x:Bind ViewModel.HasAttachments, Mode=OneWay}">
            <StackPanel Spacing="4">
                <TextBlock Text="Attachments"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Attachments}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="8"/>
                    </ItemsRepeater.Layout>
                    <DataTemplate x:DataType="vm:AttachmentItemViewModel">
                        <Border Padding="8"
                                CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Width="140">
                            <StackPanel Spacing="6">
                                <Grid Height="80" CornerRadius="4"
                                      Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                    <Image Stretch="UniformToFill"
                                           Visibility="{x:Bind IsImage}">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind ThumbnailUri}"/>
                                        </Image.Source>
                                    </Image>
                                    <FontIcon Glyph="&#xE8A5;"
                                              FontSize="28"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Visibility="{x:Bind IsDocument}"/>
                                </Grid>
                                <TextBlock Text="{x:Bind FileName}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           ToolTipService.ToolTip="{x:Bind FileName}"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Content="Open"
                                            Command="{x:Bind OpenCommand}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Padding="8,2"
                                            FontSize="11"/>
                                    <Button Command="{x:Bind RemoveCommand}"
                                            Padding="8,2"
                                            FontSize="11">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater>
            </StackPanel>
        </Border>

    </Grid>

</Page>
