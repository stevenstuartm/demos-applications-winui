<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- LIGHT THEME — Pascal Ivory + Muted Forest Green        -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <ResourceDictionary x:Key="Light">

            <!-- Page / scaffold -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FDF8F0" />

            <!-- Cards / surfaces -->
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E5DDD2" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#F5EFE5" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1A1812" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6B665E" />

            <!-- TextBox / PasswordBox (lightweight styling) -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FEFCF8" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#CCC5BA" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#AAA49A" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4A7C59" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#1A1812" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#9A9488" />

            <!-- Accent button (green) -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#4A7C59" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3E6A4C" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#325840" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#CCC5BA" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#F0EBE3" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#9A9488" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />

            <!-- Default button -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#F5EFE5" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EBE4D8" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E0D9CC" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#F5EFE5" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#1A1812" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1A1812" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#1A1812" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#9A9488" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#E5DDD2" />

            <!-- App-specific named resources -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#4A7C59" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#3E6A4C" />
            <SolidColorBrush x:Key="AppContainerBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppContainerBorderBrush" Color="#E5DDD2" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#E5DDD2" />

        </ResourceDictionary>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- DARK THEME — Warm dark + Brighter Green                -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <ResourceDictionary x:Key="Dark">

            <!-- Page / scaffold -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#1E1C18" />

            <!-- Cards / surfaces -->
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2A2722" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3D3830" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#252320" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F0EBE3" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9A9488" />

            <!-- TextBox / PasswordBox (lightweight styling) -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#2A2722" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#312E28" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2A2722" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#4A453D" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#5A544A" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#6BAF7B" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#F0EBE3" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6B665E" />

            <!-- Accent button (green) -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#6BAF7B" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#7DC08D" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#8FD09E" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#3D3830" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#1A1812" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1A1812" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#1A1812" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#6B665E" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />

            <!-- Default button -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#2A2722" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#352F2A" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3D3830" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#252320" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#F0EBE3" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F0EBE3" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F0EBE3" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6B665E" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3D3830" />

            <!-- App-specific named resources -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#6BAF7B" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#7DC08D" />
            <SolidColorBrush x:Key="AppContainerBackgroundBrush" Color="#2A2722" />
            <SolidColorBrush x:Key="AppContainerBorderBrush" Color="#3D3830" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#3D3830" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Implicit styles (theme-agnostic, reference ThemeResources) -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <Style TargetType="Page">
        <Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

</ResourceDictionary>
